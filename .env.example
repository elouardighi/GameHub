# ---------------------------------------------------------------------------
# GameHub — environment configuration
# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env      (or: copy .env.example .env on Windows)
# ---------------------------------------------------------------------------

# SQLite database location.
# Relative paths are resolved from the `prisma/` directory (where schema.prisma
# lives), so `../db/custom.db` points at `<project-root>/db/custom.db`.
DATABASE_URL="file:../db/custom.db"

# Public URL of the app. NextAuth uses this to build callback URLs.
# Use http://localhost:3000 for local development.
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign session tokens. Generate a fresh one for any real
# deployment:   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
