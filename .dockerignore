# Dependencies
node_modules
**/node_modules
bun.lockb

# Next.js
.next
**/.next
out

# Build artefacts
build
dist

# Environment — never bake secrets into the image
.env
.env.*
!.env.example

# Database files — the committed demo database IS kept so the container can
# bootstrap itself (see scripts/docker-db-init.sh). The runtime image does not
# copy it in; the database lives on a volume.
db/*.db
*.db
!db/custom.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log
server.log

# VCS / CI
.git
.github
.gitignore
.gitattributes

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docs & config that the image does not need
README.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
CHANGELOG.md
LICENSE
docker-compose.yml
Dockerfile
**/Dockerfile
